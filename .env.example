# ===========================================================================
# Backend environment template
# ---------------------------------------------------------------------------
# COPY this file to `.env` (gitignored) and fill real values for local dev.
# In production the SAME keys are set directly on the host (e.g. Vercel
# project -> Settings -> Environment variables) - nothing here is a real
# secret, and nothing concrete is ever committed.
#
# These are the ONLY keys the backend actually reads (src/config/env.ts).
# Keep this file in sync with that module whenever a key is added/removed.
# ===========================================================================

# Node
NODE_ENV=development
PORT=5000

# MongoDB - local dev default; use a real Mongo Atlas connection string in
# production.
MONGODB_URI=mongodb://127.0.0.1:27017/purely

# Accepted/deployed client origin. Used for CORS (`origin: true` reflects the
# request origin) and as the example placeholder here - set the exact deployed
# frontend URL in production (CORS + email/deep-link base).
CLIENT_URL=https://your-frontend.example.com

# Auth
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# Cloudinary (design-asset + product-file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (AI-assisted copy / error recovery)
GEMINI_API_KEY=
